<Window x:Class="PdfDesk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:PdfDesk.App"
        Title="PdfDesk" Icon="PdfDesk.ico" AllowDrop="True" Background="Transparent"
        Width="1280" Height="860" MinWidth="720" MinHeight="460">
    <!-- Content extends into the title bar; DWM still draws (and hit-tests) the real caption buttons, so Snap Layouts work. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" GlassFrameThickness="-1" UseAeroCaptionButtons="True"
                      ResizeBorderThickness="6" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: app icon, document tabs, new-tab button; empty space drags the window -->
        <Grid x:Name="TitleBar" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="CaptionColumn" Width="140" />
            </Grid.ColumnDefinitions>
            <Image Source="PdfDesk.ico" Width="16" Height="16" Margin="14,0,10,0" VerticalAlignment="Center" />
            <!-- Tabs get at most the width left after the + button and a drag strip (set in code); they shrink, then scroll. -->
            <DockPanel x:Name="TabArea" Grid.Column="1" LastChildFill="False">
                <ListBox x:Name="TabStrip" DockPanel.Dock="Left" Background="Transparent" BorderThickness="0" Padding="0"
                         WindowChrome.IsHitTestVisibleInChrome="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="False" AutomationProperties.Name="Open documents">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource TitleTab}">
                            <Setter Property="MinWidth" Value="110" />
                            <Setter Property="MaxWidth" Value="{Binding TabMaxWidth, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type app:TabModel}">
                            <DockPanel ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding Title}" Background="Transparent">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" FontSize="10" Height="24" MinWidth="24" Padding="4"
                                        Content="&#xE711;" ToolTip="{x:Static app:Cmd.CloseTabTip}" Click="OnTabCloseClick" Margin="6,0,0,0" />
                                <TextBlock DockPanel.Dock="Left" Text="&#xE915;" FontFamily="{StaticResource Icons}" FontSize="9" Margin="0,0,6,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           Visibility="{Binding DirtyVisibility}" ToolTip="Unsaved changes" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button x:Name="NewTabButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}" FontSize="12" Height="30" MinWidth="30"
                        Margin="4,6,0,0" Content="&#xE710;" ToolTip="Open a file" Command="app:Cmd.Open"
                        WindowChrome.IsHitTestVisibleInChrome="True" />
                <ProgressBar x:Name="OpenProgress" DockPanel.Dock="Left" IsIndeterminate="True" Width="48" Height="4" Margin="10,4,0,0"
                             VerticalAlignment="Center" Visibility="Collapsed" AutomationProperties.Name="Opening files" />
                <TextBlock x:Name="AppTitle" DockPanel.Dock="Left" Text="PdfDesk" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" />
            </DockPanel>
        </Grid>

        <!-- Surface below the title bar -->
        <Border x:Name="Surface" Grid.Row="1" Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}">
            <DockPanel>
                <!-- Menu + command bar -->
                <Border x:Name="CommandBar" DockPanel.Dock="Top" Padding="4,4,8,4"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <!-- One row at every width: commands that don't fit go into the "More" (…) menu at the end of the bar. -->
                    <DockPanel MinHeight="34">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource CommandButton}" Command="app:Cmd.CommandPalette" ToolTip="Search all commands">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE765;" FontSize="14" />
                                    <TextBlock Text="Commands" Margin="8,0,8,0" VerticalAlignment="Center" />
                                    <Border CornerRadius="3" Padding="5,0,5,1" BorderThickness="1" VerticalAlignment="Center"
                                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                        <TextBlock x:Name="PaletteKeyText" FontSize="11" Style="{StaticResource Caption}" />
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button x:Name="AppearanceButton" Style="{StaticResource IconButton}" Content="&#xE708;" Click="OnAppearanceClick"
                                    ToolTip="Appearance: dark mode, light mode, dark pages" />
                            <Button Style="{StaticResource IconButton}" Command="app:Cmd.Settings" Content="&#xE713;" ToolTip="Settings" />
                        </StackPanel>
                        <DockPanel VerticalAlignment="Stretch">
                            <Menu x:Name="MainMenu" DockPanel.Dock="Left" Background="Transparent" VerticalAlignment="Center" Margin="0,0,4,0">
                                <MenuItem Header="_File">
                                    <MenuItem Command="app:Cmd.Open" />
                                    <MenuItem x:Name="RecentMenu" Header="Open _Recent" />
                                    <MenuItem Command="app:Cmd.Combine" />
                                    <MenuItem Command="app:Cmd.NewFromImages" />
                                    <MenuItem Command="app:Cmd.NewFromClipboard" />
                                    <Separator />
                                    <MenuItem Command="app:Cmd.Save" />
                                    <MenuItem Command="app:Cmd.SaveAs" />
                                    <MenuItem Command="app:Cmd.ShowInFolder" />
                                    <MenuItem Command="app:Cmd.ReloadFromDisk" />
                                    <Separator />
                                    <MenuItem Command="app:Cmd.Print" />
                                    <MenuItem Command="app:Cmd.ExportImages" />
                                    <MenuItem Command="app:Cmd.Properties" />
                                    <MenuItem Command="app:Cmd.ProtectPassword" />
                                    <MenuItem Command="app:Cmd.RemoveProtection" />
                                    <MenuItem Command="app:Cmd.ReduceSize" />
                                    <Separator />
                                    <MenuItem Command="app:Cmd.CloseDoc" />
                                    <MenuItem Command="app:Cmd.CloseAll" />
                                    <MenuItem Command="app:Cmd.ReopenClosed" />
                                    <Separator />
                                    <MenuItem Command="app:Cmd.Settings" />
                                    <MenuItem Command="app:Cmd.Exit" InputGestureText="Alt+F4" />
                                </MenuItem>
                                <MenuItem Header="_Edit">
                                    <MenuItem x:Name="UndoMenu" Command="app:Cmd.Undo" />
                                    <MenuItem x:Name="RedoMenu" Command="app:Cmd.Redo" />
                                    <Separator />
                                    <MenuItem Command="app:Cmd.Copy" />
                                    <MenuItem Command="app:Cmd.SelectAll" />
                                    <Separator />
                                    <MenuItem Command="app:Cmd.Find" />
                                    <MenuItem Command="app:Cmd.FindNext" />
                                    <MenuItem Command="app:Cmd.FindPrevious" />
                                    <MenuItem Command="app:Cmd.SearchPane" />
                                    <Separator />
                                    <MenuItem x:Name="HandMenu" Command="app:Cmd.ToolHand" InputGestureText="H" />
                                    <MenuItem x:Name="SelectMenu" Command="app:Cmd.ToolSelect" InputGestureText="T" />
                                    <MenuItem x:Name="SnapshotMenu" Command="app:Cmd.ToolSnapshot" InputGestureText="G" />
                                    <Separator />
                                    <!-- Fill & Sign: type or mark on any page, handwritten signature (digital signing is under Review) -->
                                    <MenuItem Header="_Fill &amp; Sign">
                                        <MenuItem x:Name="AddTextMenu" Command="app:Cmd.ToolAddText" InputGestureText="A" />
                                        <MenuItem x:Name="CheckMenu" Command="app:Cmd.ToolCheck" InputGestureText="K" />
                                        <MenuItem x:Name="CrossMenu" Command="app:Cmd.ToolCross" InputGestureText="X" />
                                        <MenuItem Command="app:Cmd.AddSignature" />
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Command="app:Cmd.CommandPalette" />
                                </MenuItem>
                                <MenuItem Header="_View">
                                    <MenuItem Command="app:Cmd.ZoomIn" />
                                    <MenuItem Command="app:Cmd.ZoomOut" />
                                    <MenuItem Command="app:Cmd.ActualSize" />
                                    <MenuItem x:Name="FitWidthMenu" Command="app:Cmd.FitWidth" />
                                    <MenuItem x:Name="FitPageMenu" Command="app:Cmd.FitPage" />
                                    <Separator />
                                    <MenuItem x:Name="SingleMenu" Command="app:Cmd.LayoutSingle" />
                                    <MenuItem x:Name="ContinuousMenu" Command="app:Cmd.LayoutContinuous" />
                                    <MenuItem x:Name="FacingMenu" Command="app:Cmd.LayoutFacing" />
                                    <MenuItem x:Name="CoverMenu" Command="app:Cmd.LayoutCover" />
                                    <MenuItem Command="app:Cmd.RotateViewRight" />
                                    <MenuItem Command="app:Cmd.RotateViewLeft" />
                                    <Separator />
                                    <MenuItem Command="app:Cmd.FirstPage" />
                                    <MenuItem Command="app:Cmd.PrevPage" />
                                    <MenuItem Command="app:Cmd.NextPage" />
                                    <MenuItem Command="app:Cmd.LastPage" />
                                    <MenuItem Command="app:Cmd.GoToPage" />
                                    <MenuItem Command="app:Cmd.Back" />
                                    <MenuItem Command="app:Cmd.Forward" />
                                    <Separator />
                                    <MenuItem x:Name="NavPaneMenu" Command="app:Cmd.NavPane" />
                                    <MenuItem Header="_Bookmarks" Click="OnShowBookmarks" />
                                    <MenuItem Command="app:Cmd.AddBookmark" />
                                    <MenuItem x:Name="ReadAloudMenu" Command="app:Cmd.ReadAloud" />
                                    <MenuItem Header="_Theme">
                                        <MenuItem x:Name="ThemeSystemMenu" Header="Use _Windows setting" Click="OnThemeMenu" Tag="System" />
                                        <MenuItem x:Name="ThemeLightMenu" Header="_Light" Click="OnThemeMenu" Tag="Light" />
                                        <MenuItem x:Name="ThemeDarkMenu" Header="_Dark" Click="OnThemeMenu" Tag="Dark" />
                                    </MenuItem>
                                    <MenuItem Command="app:Cmd.ToggleDarkMode" />
                                    <MenuItem x:Name="DarkPagesMenu" Command="app:Cmd.DarkPages" />
                                    <MenuItem x:Name="HighlightFieldsMenu" Command="app:Cmd.HighlightFields" />
                                    <MenuItem Command="app:Cmd.FullScreen" />
                                </MenuItem>
                                <MenuItem Header="_Organize">
                                    <MenuItem x:Name="OrganizeMenu" Command="app:Cmd.Organize" />
                                    <Separator />
                                    <MenuItem Command="app:Cmd.RotateRight" />
                                    <MenuItem Command="app:Cmd.RotateLeft" />
                                    <MenuItem Command="app:Cmd.RotatePages" />
                                    <Separator />
                                    <MenuItem Command="app:Cmd.InsertPages" />
                                    <MenuItem Command="app:Cmd.InsertBlank" />
                                    <Separator />
                                    <MenuItem Command="app:Cmd.DeletePages" />
                                    <MenuItem Command="app:Cmd.ExtractPages" />
                                    <MenuItem Command="app:Cmd.SplitDocument" />
                                    <Separator />
                                    <MenuItem Command="app:Cmd.MovePages" />
                                    <MenuItem Command="app:Cmd.DuplicatePages" />
                                    <MenuItem Command="app:Cmd.ReversePages" />
                                    <Separator />
                                    <MenuItem Command="app:Cmd.CropPages" />
                                    <MenuItem Command="app:Cmd.Flatten" />
                                    <Separator />
                                    <MenuItem Command="app:Cmd.Combine" />
                                </MenuItem>
                                <MenuItem Header="_Review">
                                    <MenuItem Command="app:Cmd.ShowComments" />
                                    <MenuItem Command="app:Cmd.ShowAttachments" />
                                    <MenuItem Command="app:Cmd.ShowLayers" />
                                    <MenuItem Command="app:Cmd.ShowSignatures" />
                                    <MenuItem x:Name="SignMenu" Command="app:Cmd.Sign" />
                                    <Separator />
                                    <MenuItem Command="app:Cmd.Highlight" />
                                    <MenuItem Command="app:Cmd.Underline" />
                                    <MenuItem Command="app:Cmd.StrikeOut" />
                                    <MenuItem x:Name="NoteMenu" Command="app:Cmd.AddNote" />
                                    <Separator />
                                    <MenuItem x:Name="AttachMenu" Header="Attach a _File…" Click="OnAttachFile" />
                                    <MenuItem Command="app:Cmd.RecognizeText" />
                                    <Separator />
                                    <MenuItem x:Name="RedactMenu" Command="app:Cmd.Redact" />
                                    <MenuItem x:Name="RedactTextMenu" Header="Mark Selected _Text for Redaction" Click="OnRedactText" />
                                    <MenuItem x:Name="RedactHitsMenu" Header="Mark Search _Matches for Redaction" Click="OnRedactHits" />
                                    <MenuItem x:Name="ApplyRedactMenu" Header="_Apply Redactions…" Click="OnApplyRedactions" />
                                </MenuItem>
                                <MenuItem Header="_Help">
                                    <MenuItem Command="app:Cmd.Shortcuts" />
                                    <MenuItem Command="app:Cmd.CommandPalette" />
                                    <MenuItem Header="Open _Log Folder" Click="OnOpenLog" />
                                    <Separator />
                                    <MenuItem Header="_About PdfDesk" Click="OnAbout" />
                                </MenuItem>
                            </Menu>
                            <!-- Tooltips name the action; the shortcut is added from the command's own gestures (Cmd.AddShortcutsToTips).
                                 Letter keys (H, T, G, A, K, X) are page-view keys, not commands, so they are written here. -->
                            <!-- Without a document only Combine applies; with one it moves into the document commands -->
                            <Button x:Name="NoDocCombineButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Command="app:Cmd.Combine"
                                    ToolTip="Combine several PDFs into one" Content="&#xE8F1;" />
                            <app:ToolbarPanel x:Name="DocCommands" VerticalAlignment="Center">
                                <Border Style="{StaticResource BarSeparator}" />
                                <Button Style="{StaticResource IconButton}" Command="app:Cmd.Save" ToolTip="Save" Content="&#xE74E;" />
                                <Button Style="{StaticResource IconButton}" Command="app:Cmd.Print" ToolTip="Print" Content="&#xE749;" />
                                <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Command="app:Cmd.Undo" ToolTip="Undo" Content="&#xE7A7;" />
                                <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Command="app:Cmd.Redo" ToolTip="Redo" Content="&#xE7A6;" />
                                <Border Style="{StaticResource BarSeparator}" />
                                <ToggleButton x:Name="HandButton" Style="{StaticResource IconButton}" Command="app:Cmd.ToolHand" ToolTip="Hand tool: drag to scroll (H)" Content="&#xE7C9;" />
                                <ToggleButton x:Name="SelectButton" Style="{StaticResource IconButton}" Command="app:Cmd.ToolSelect" ToolTip="Select text (T)" Content="&#xE8E9;" />
                                <ToggleButton x:Name="SnapshotButton" Style="{StaticResource IconButton}" Command="app:Cmd.ToolSnapshot" ToolTip="Snapshot: drag to copy an area as an image (G)" Content="&#xE722;" />
                                <Border Style="{StaticResource BarSeparator}" />
                                <ToggleButton x:Name="AddTextButton" Style="{StaticResource CommandButton}" Command="app:Cmd.ToolAddText"
                                              ToolTip="Fill &amp; Sign, add text: click anywhere on a page to type, e.g. on a scanned form (A)" AutomationProperties.Name="Add text">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8D2;" FontSize="15" />
                                        <TextBlock Text="Add text" Margin="8,0,0,0" VerticalAlignment="Center" app:ToolbarPanel.IsLabel="True" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="CheckButton" Style="{StaticResource IconButton}" Command="app:Cmd.ToolCheck" Content="&#xE73E;"
                                              ToolTip="Fill &amp; Sign, check mark: click on the page where it goes (K)" AutomationProperties.Name="Add check mark" />
                                <ToggleButton x:Name="CrossButton" Style="{StaticResource IconButton}" Command="app:Cmd.ToolCross" Content="&#xE711;"
                                              ToolTip="Fill &amp; Sign, cross: click on the page where it goes (X)" AutomationProperties.Name="Add cross" />
                                <ToggleButton x:Name="AddSignatureButton" Style="{StaticResource CommandButton}" Command="app:Cmd.AddSignature"
                                              ToolTip="Sign: place your handwritten signature or initials, or sign digitally with a certificate" AutomationProperties.Name="Sign">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE76D;" FontSize="15" />
                                        <TextBlock Text="Sign" Margin="8,0,0,0" VerticalAlignment="Center" app:ToolbarPanel.IsLabel="True" />
                                    </StackPanel>
                                </ToggleButton>
                                <Border Style="{StaticResource BarSeparator}" />
                                <Button Style="{StaticResource IconButton}" Command="app:Cmd.Highlight" Content="&#xE7E6;" ToolTip="Highlight the selected text" AutomationProperties.Name="Highlight" />
                                <ToggleButton x:Name="NoteButton" Style="{StaticResource IconButton}" Command="app:Cmd.AddNote" Content="&#xE90A;" ToolTip="Add a note: click on the page where it goes" AutomationProperties.Name="Add note" />
                                <ToggleButton x:Name="RedactButton" Style="{StaticResource IconButton}" Command="app:Cmd.Redact" Content="&#xE73B;"
                                              ToolTip="Redact: drag over areas to black out, then apply (removes the content for good)" AutomationProperties.Name="Redact" />
                                <Border Style="{StaticResource BarSeparator}" />
                                <ToggleButton x:Name="OrganizeButton" Style="{StaticResource CommandButton}" Command="app:Cmd.Organize" ToolTip="Organize pages: reorder, rotate, delete in a grid">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B3;" FontSize="15" />
                                        <TextBlock Text="Organize" Margin="8,0,0,0" VerticalAlignment="Center" app:ToolbarPanel.IsLabel="True" />
                                    </StackPanel>
                                </ToggleButton>
                                <Button Style="{StaticResource IconButton}" Command="app:Cmd.RotateLeft" ToolTip="Rotate pages counterclockwise" Content="&#xE7AD;" AutomationProperties.Name="Rotate pages counterclockwise" />
                                <Button Style="{StaticResource IconButton}" Command="app:Cmd.RotateRight" ToolTip="Rotate pages clockwise" Content="&#xE7AD;" RenderTransformOrigin="0.5,0.5"
                                        AutomationProperties.Name="Rotate pages clockwise">
                                    <Button.RenderTransform>
                                        <ScaleTransform ScaleX="-1" />
                                    </Button.RenderTransform>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Command="app:Cmd.DeleteSelected" ToolTip="Delete selected pages (Del)" Content="&#xE74D;" />
                                <Border Style="{StaticResource BarSeparator}" />
                                <Button Style="{StaticResource IconButton}" Command="app:Cmd.Find" ToolTip="Find in document" Content="&#xE721;" />
                                <Button Style="{StaticResource IconButton}" Command="app:Cmd.Combine" ToolTip="Combine several PDFs into one" Content="&#xE8F1;" />
                                <Button x:Name="MoreButton" app:ToolbarPanel.IsOverflowButton="True" Style="{StaticResource IconButton}" Content="&#xE712;"
                                        ToolTip="More commands" Click="OnMoreClick" />
                            </app:ToolbarPanel>
                        </DockPanel>
                    </DockPanel>
                </Border>

                <Grid x:Name="ContentArea">
                    <!-- Open documents (one visible at a time; hidden ones keep their state) -->
                    <Grid x:Name="DocsHost" />

                    <!-- Start page -->
                    <ScrollViewer x:Name="StartPage" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="920" Margin="40,40,40,32">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="PdfDeskLogo.png" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="PdfDesk" Style="{DynamicResource TitleTextBlockStyle}" />
                                    <TextBlock Text="Read, search, print and organize PDFs." Style="{StaticResource Caption}" FontSize="14" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <UniformGrid Columns="2" Margin="0,28,0,0">
                                <Button x:Name="OpenCard" Command="app:Cmd.Open" Margin="0,0,8,0" Padding="20" HorizontalContentAlignment="Stretch">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="28" Margin="0,0,16,0"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <StackPanel>
                                            <TextBlock Text="Open a file" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="PDF, XPS, EPUB, images · or drop files anywhere" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                                <Button Command="app:Cmd.Combine" Margin="8,0,0,0" Padding="20" HorizontalContentAlignment="Stretch">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE8F1;" FontSize="28" Margin="0,0,16,0"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <StackPanel>
                                            <TextBlock Text="Combine files" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="Merge several PDFs into one, in the order you choose" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                            </UniformGrid>

                            <DockPanel x:Name="RecentHeader" Margin="0,32,0,10">
                                <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Content="Clear list" Click="OnClearRecent" />
                                <TextBlock Text="Recent" Style="{DynamicResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl x:Name="RecentList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type app:RecentItem}">
                                        <Button Click="OnRecentClick" Tag="{Binding Path}" Width="168" Margin="0,0,12,12" Padding="10"
                                                HorizontalContentAlignment="Stretch" ToolTip="{Binding Path}"
                                                AutomationProperties.Name="{Binding Name}">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="_Open" Click="OnRecentMenuOpen" Tag="{Binding Path}" />
                                                    <MenuItem Header="Show in _Folder" Click="OnRecentMenuShow" Tag="{Binding Path}" />
                                                    <Separator />
                                                    <MenuItem Header="_Remove from List" Click="OnRecentMenuRemove" Tag="{Binding Path}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <StackPanel>
                                                <Border Height="190" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" CornerRadius="4">
                                                    <Grid>
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="32" Opacity="0.35" />
                                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="8">
                                                            <Image.Effect>
                                                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.25" />
                                                            </Image.Effect>
                                                        </Image>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoRecent" Text="Files you open will appear here." Style="{StaticResource Caption}" Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Drop overlay -->
                    <Border x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False" Margin="12" CornerRadius="12"
                            BorderThickness="2" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                            Background="{DynamicResource SmokeFillColorDefaultBrush}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="40" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="DropText" Text="Drop to open" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Toasts (bottom-left) -->
                    <StackPanel x:Name="Toasts" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,76" />

                    <!-- Command palette -->
                    <Grid x:Name="Palette" Visibility="Collapsed" Background="Transparent">
                        <Border Width="600" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,0,0" Padding="8"
                                CornerRadius="10" Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.28" />
                            </Border.Effect>
                            <DockPanel>
                                <Grid DockPanel.Dock="Top">
                                    <TextBox x:Name="PaletteBox" FontSize="15" Padding="10,8"
                                             AutomationProperties.Name="Type a command, file, or page number" />
                                    <!-- Placeholder: shown while the box is empty -->
                                    <TextBlock Text="Type a command, file, or page number" FontSize="15" Margin="13,0,0,0" VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=PaletteBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <TextBlock DockPanel.Dock="Bottom" Margin="6,8,6,2" FontSize="11" Style="{StaticResource Caption}"
                                           Text="↑↓ to choose · Enter to run · Esc to close · type a number to go to that page" />
                                <ListBox x:Name="PaletteList" MaxHeight="420" Margin="0,8,0,0" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource SubtleListItem}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Commands">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type app:PaletteItem}">
                                            <DockPanel Margin="2,3">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Gesture}" Style="{StaticResource Caption}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" />
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" Width="22" FontSize="13"
                                                           VerticalAlignment="Center" Style="{StaticResource Caption}" />
                                                <TextBlock Text="{Binding Category}" DockPanel.Dock="Left" Style="{StaticResource Caption}" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>

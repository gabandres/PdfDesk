<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(WinTfm)</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>PdfDesk</AssemblyName>
    <RootNamespace>PdfDesk.App</RootNamespace>
    <ApplicationIcon>..\..\assets\PdfDesk.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- ThemeMode (Fluent) is marked experimental in WPF -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PdfDesk.Core\PdfDesk.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="..\..\assets\PdfDesk.ico" Link="PdfDesk.ico" />
    <Resource Include="..\..\assets\PdfDesk-512.png" Link="PdfDeskLogo.png" />
  </ItemGroup>
</Project>

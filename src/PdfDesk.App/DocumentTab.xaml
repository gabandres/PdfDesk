<UserControl x:Class="PdfDesk.App.DocumentTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:PdfDesk.App.Viewer"
             xmlns:app="clr-namespace:PdfDesk.App"
             xmlns:core="clr-namespace:PdfDesk.Core;assembly=PdfDesk.Core">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="NavColumn" Width="220" MinWidth="0" />
            <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Icon rail: one click opens a pane, clicking the open one closes it -->
        <StackPanel x:Name="Rail" Grid.Column="0" Margin="4,6,4,0" Width="40">
            <ToggleButton x:Name="PagesRail" Style="{StaticResource RailButton}" Content="&#xE8A9;" ToolTip="Pages (thumbnails)" />
            <ToggleButton x:Name="BookmarksRail" Style="{StaticResource RailButton}" Content="&#xE8A4;" ToolTip="Bookmarks" />
            <ToggleButton x:Name="SearchRail" Style="{StaticResource RailButton}" Content="&#xE721;" ToolTip="Search (Ctrl+Shift+F)" />
            <ToggleButton x:Name="CommentsRail" Style="{StaticResource RailButton}" Content="&#xE90A;" ToolTip="Comments"
                          AutomationProperties.Name="Comments" />
            <Grid x:Name="AttachmentsRailHost">
                <ToggleButton x:Name="AttachmentsRail" Style="{StaticResource RailButton}" Content="&#xE723;" ToolTip="Attachments"
                              AutomationProperties.Name="Attachments" />
                <Border x:Name="AttachmentsBadge" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,4,2,0" MinWidth="16" Height="16" CornerRadius="8" Padding="4,0" Background="{DynamicResource AccentFillColorDefaultBrush}">
                    <TextBlock x:Name="AttachmentsBadgeText" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
            </Grid>
            <ToggleButton x:Name="LayersRail" Style="{StaticResource RailButton}" Content="&#xE81E;" ToolTip="Layers" Visibility="Collapsed"
                          AutomationProperties.Name="Layers" />
            <ToggleButton x:Name="SignaturesRail" Style="{StaticResource RailButton}" Content="&#xEB95;" ToolTip="Signatures" Visibility="Collapsed"
                          AutomationProperties.Name="Signatures" />
        </StackPanel>

        <!-- Navigation pane -->
        <Border x:Name="NavPane" Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="14,10,6,6" LastChildFill="False">
                    <TextBlock x:Name="PaneTitle" DockPanel.Dock="Left" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock x:Name="PaneDetail" DockPanel.Dock="Left" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}" FontSize="12" />
                    <Button x:Name="ClosePaneButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" FontSize="11" Height="28" MinWidth="28"
                            Content="&#xE711;" ToolTip="Close pane (F4)" />
                </DockPanel>
                <Grid>
                    <ListBox x:Name="Thumbs" SelectionMode="Extended" AllowDrop="True" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel" HorizontalContentAlignment="Center"
                             AutomationProperties.Name="Page thumbnails">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource SubtleListItem}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                                <Setter Property="Margin" Value="8,2" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type app:ThumbItem}">
                                <StackPanel Margin="2,6,2,2">
                                    <Border Background="White" Width="{Binding Width}" Height="{Binding Height}" HorizontalAlignment="Center">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.25" />
                                        </Border.Effect>
                                        <Image Source="{Binding Image}" Stretch="Fill" />
                                    </Border>
                                    <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="app:Cmd.RotateRight" />
                                <MenuItem Command="app:Cmd.RotateLeft" />
                                <Separator />
                                <MenuItem Command="app:Cmd.DeleteSelected" InputGestureText="Del" />
                                <MenuItem Command="app:Cmd.DuplicatePages" />
                                <MenuItem Command="app:Cmd.ExtractPages" />
                                <MenuItem Command="app:Cmd.MovePages" />
                                <Separator />
                                <MenuItem Command="app:Cmd.InsertPages" />
                                <MenuItem Command="app:Cmd.InsertBlank" />
                                <MenuItem Command="app:Cmd.CropPages" />
                                <Separator />
                                <MenuItem Command="app:Cmd.Organize" />
                                <MenuItem Command="app:Cmd.Print" Header="_Print Pages…" />
                                <MenuItem Command="app:Cmd.ExportImages" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <Grid x:Name="BookmarksPanel" Visibility="Collapsed">
                        <TreeView x:Name="Outline" BorderThickness="0" Background="Transparent" VirtualizingPanel.IsVirtualizing="True"
                                  AutomationProperties.Name="Bookmarks">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type core:OutlineNode}" ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                        <StackPanel x:Name="NoBookmarks" Margin="16,24" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A4;" FontSize="28" Opacity="0.5" HorizontalAlignment="Left" />
                            <TextBlock Text="No bookmarks" FontWeight="SemiBold" Margin="0,10,0,4" />
                            <TextBlock Text="This document doesn't have a table of contents." TextWrapping="Wrap" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </Grid>

                    <DockPanel x:Name="SearchPanel" Margin="10,0,10,8" Visibility="Collapsed">
                        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" AutomationProperties.Name="Search text" />
                        <WrapPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                            <CheckBox x:Name="SearchMatchCase" Content="Match case" Margin="0,0,12,0" />
                            <CheckBox x:Name="SearchWholeWords" Content="Whole words" Margin="0,0,12,0" />
                            <CheckBox x:Name="SearchIgnoreAccents" Content="Ignore accents" ToolTip="Find é, è and ê when you type e" />
                        </WrapPanel>
                        <Button x:Name="SearchButton" DockPanel.Dock="Top" Content="Search" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                Style="{DynamicResource AccentButtonStyle}" />
                        <TextBlock x:Name="SearchStatus" DockPanel.Dock="Top" Margin="0,10,0,6" TextWrapping="Wrap" Style="{StaticResource Caption}" />
                        <Button x:Name="RedactHitsButton" DockPanel.Dock="Top" Style="{StaticResource TextButton}" HorizontalAlignment="Left" Margin="-8,0,0,4"
                                Content="Mark all matches for redaction" Visibility="Collapsed"
                                ToolTip="Marks every match for redaction; review the marks, then apply them from the bar above the pages" />
                        <ListBox x:Name="SearchResults" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                                 AutomationProperties.Name="Search results">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource SubtleListItem}">
                                    <Setter Property="AutomationProperties.Name">
                                        <Setter.Value>
                                            <MultiBinding StringFormat="{}{0}: {1}">
                                                <Binding Path="PageLabel" />
                                                <Binding Path="Excerpt" />
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type v:SearchHit}">
                                    <StackPanel Margin="0,3">
                                        <TextBlock Text="{Binding PageLabel}" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="{Binding Excerpt}" TextWrapping="Wrap" FontSize="12" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- Comments: grouped by page, filter, edit, delete -->
                    <DockPanel x:Name="CommentsPanel" Margin="10,0,10,8" Visibility="Collapsed">
                        <TextBox x:Name="CommentFilter" DockPanel.Dock="Top" AutomationProperties.Name="Filter comments"
                                 ToolTip="Show only comments containing this text, author or type" />
                        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,6,0,2">
                            <Button Style="{StaticResource IconButton}" Command="app:Cmd.Highlight" Content="&#xE7E6;" FontSize="14"
                                    ToolTip="Highlight the selected text (Ctrl+Shift+H)" AutomationProperties.Name="Highlight" />
                            <Button Style="{StaticResource IconButton}" Command="app:Cmd.Underline" Content="&#xE8DC;" FontSize="14"
                                    ToolTip="Underline the selected text" AutomationProperties.Name="Underline" />
                            <Button Style="{StaticResource IconButton}" Command="app:Cmd.StrikeOut" Content="&#xE738;" FontSize="14"
                                    ToolTip="Strike out the selected text" AutomationProperties.Name="Strike out" />
                            <ToggleButton x:Name="NoteToolButton" Style="{StaticResource IconButton}" Command="app:Cmd.AddNote" Content="&#xE70B;" FontSize="14"
                                          ToolTip="Add a note: click on the page where it goes" AutomationProperties.Name="Add note" />
                            <Border Style="{StaticResource BarSeparator}" />
                            <Button x:Name="CommentEditButton" Style="{StaticResource IconButton}" Content="&#xE70F;" FontSize="14" IsEnabled="False"
                                    ToolTip="Edit the comment's text (Enter)" AutomationProperties.Name="Edit comment text" />
                            <Button x:Name="CommentDeleteButton" Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="14" IsEnabled="False"
                                    ToolTip="Delete the comment (Del)" AutomationProperties.Name="Delete comment" />
                        </WrapPanel>
                        <TextBlock x:Name="CommentsEmpty" DockPanel.Dock="Top" Margin="4,10,4,0" TextWrapping="Wrap" Style="{StaticResource Caption}" />
                        <ListBox x:Name="CommentList" BorderThickness="0" Background="Transparent" Margin="-4,4,-4,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel"
                                 AutomationProperties.Name="Comments">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource SubtleListItem}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Margin="8,10,0,2" Style="{StaticResource Caption}" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type app:CommentItem}">
                                    <DockPanel Margin="{Binding Indent}">
                                        <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="4" Margin="0,2,8,0" VerticalAlignment="Top"
                                                Background="{Binding Swatch}">
                                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="13" Foreground="{Binding GlyphBrush}" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock FontSize="12" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="{Binding Meta, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Contents}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,2" MaxHeight="64"
                                                       TextTrimming="CharacterEllipsis" Visibility="{Binding ContentsVisibility}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="CommentEditMenu" Header="_Edit Text…" InputGestureText="Enter" />
                                    <MenuItem x:Name="CommentDeleteMenu" Header="_Delete" InputGestureText="Del" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </DockPanel>

                    <!-- Attachments -->
                    <DockPanel x:Name="AttachmentsPanel" Margin="10,0,10,8" Visibility="Collapsed">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,2">
                            <Button x:Name="AttachSaveButton" Style="{StaticResource IconButton}" Content="&#xE74E;" FontSize="14" IsEnabled="False"
                                    ToolTip="Save the attachment as a file…" AutomationProperties.Name="Save attachment as" />
                            <Button x:Name="AttachOpenButton" Style="{StaticResource IconButton}" Content="&#xE8E5;" FontSize="14" IsEnabled="False"
                                    ToolTip="Open the attached PDF in a new tab" AutomationProperties.Name="Open attached PDF" />
                            <Border Style="{StaticResource BarSeparator}" />
                            <Button x:Name="AttachAddButton" Style="{StaticResource IconButton}" Content="&#xE710;" FontSize="14"
                                    ToolTip="Attach a file…" AutomationProperties.Name="Add attachment" />
                            <Button x:Name="AttachRemoveButton" Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="14" IsEnabled="False"
                                    ToolTip="Remove the attachment (Del)" AutomationProperties.Name="Remove attachment" />
                        </StackPanel>
                        <TextBlock x:Name="AttachmentsEmpty" DockPanel.Dock="Top" Margin="4,10,4,0" TextWrapping="Wrap" Style="{StaticResource Caption}"
                                   Text="No files are attached to this document. Use + to attach one." />
                        <ListBox x:Name="AttachmentList" BorderThickness="0" Background="Transparent" Margin="-4,4,-4,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Attachments">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource SubtleListItem}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                                    <Setter Property="ToolTip" Value="{Binding Tip}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type app:AttachmentItem}">
                                    <DockPanel Margin="0,3">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="18" Margin="0,0,10,0"
                                                   VerticalAlignment="Top" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- Layers (optional content): visibility for viewing and printing -->
                    <DockPanel x:Name="LayersPanel" Margin="10,0,10,8" Visibility="Collapsed">
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Style="{StaticResource Caption}" FontSize="12" Margin="4,0,4,6"
                                   Text="Show or hide layers for viewing and printing. The file itself doesn't change." />
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button x:Name="LayersResetButton" Content="Reset" Margin="0,0,8,4" IsEnabled="False"
                                    ToolTip="Back to the layers the document shows by default" />
                            <Button x:Name="LayersSaveButton" Content="Save as default" Margin="0,0,0,4" IsEnabled="False"
                                    ToolTip="Make these the layers every PDF viewer shows when it opens this file (undoable)" />
                        </WrapPanel>
                        <TreeView x:Name="LayerTree" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Layers">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type app:LayerNode}" ItemsSource="{Binding Children}">
                                    <Grid>
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEnabled}" MinHeight="0" Padding="6,0,0,0"
                                                  Visibility="{Binding CheckVisibility}" ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Label}" />
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Visibility="{Binding GroupVisibility}" />
                                    </Grid>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>

                    <!-- Digital signatures -->
                    <ScrollViewer x:Name="SignaturesPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="SignatureList" Margin="10,0,10,8" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type app:SignatureItem}">
                                    <Border Padding="10,8" Margin="0,0,0,8" CornerRadius="6" BorderThickness="1"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Top" Text="{Binding Glyph}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Severity}" Value="ok">
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="bad">
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="none">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,6" />
                                                <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="12" BorderThickness="0"
                                                         Background="Transparent" Padding="0" MinHeight="0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                         AutomationProperties.Name="Signature details" />
                                                <Button Style="{StaticResource TextButton}" Content="Go to signature" HorizontalAlignment="Left" Margin="-8,2,0,0"
                                                        Tag="{Binding}" Click="OnGoToSignature" Visibility="{Binding GoVisibility}" />
                                                <Button Style="{StaticResource TextButton}" Content="Sign this field…" HorizontalAlignment="Left" Margin="-8,0,0,0"
                                                        Tag="{Binding}" Click="OnSignField" Visibility="{Binding SignVisibility}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <GridSplitter x:Name="NavSplitter" Grid.Column="2" Width="4" HorizontalAlignment="Stretch" Background="Transparent"
                      AutomationProperties.Name="Resize pane" />

        <Grid Grid.Column="3">
            <!-- Reading view -->
            <Grid x:Name="ReadingView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                <!-- InfoBar: the file changed (or disappeared) on disk -->
                <Border x:Name="DiskBar" Visibility="Collapsed" Padding="14,8" Margin="12,10,12,0" CornerRadius="6"
                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        AutomationProperties.LiveSetting="Assertive">
                    <DockPanel>
                        <Button x:Name="DiskBarClose" DockPanel.Dock="Right" Style="{StaticResource IconButton}" FontSize="10" Height="26" MinWidth="26"
                                Content="&#xE711;" ToolTip="Dismiss" AutomationProperties.Name="Dismiss" />
                        <Button x:Name="DiskBarSecondary" DockPanel.Dock="Right" Margin="8,0,4,0" />
                        <Button x:Name="DiskBarPrimary" DockPanel.Dock="Right" Margin="12,0,0,0" Style="{DynamicResource AccentButtonStyle}" />
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="16" Margin="0,0,12,0"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <TextBlock x:Name="DiskBarText" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <!-- InfoBar: this document has fillable fields -->
                <Border x:Name="FormBar" Visibility="Collapsed" Padding="14,8" Margin="12,10,12,0" CornerRadius="6"
                        Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <DockPanel>
                        <Button x:Name="FormBarClose" DockPanel.Dock="Right" Style="{StaticResource IconButton}" FontSize="10" Height="26" MinWidth="26"
                                Content="&#xE711;" ToolTip="Dismiss" />
                        <CheckBox x:Name="HighlightFieldsBox" DockPanel.Dock="Right" Content="Highlight fields" IsChecked="True" Margin="12,0,8,0" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE70B;" FontSize="16" Margin="0,0,12,0"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="FormBarText" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <!-- InfoBar: the form is XFA-only (PdfDesk can't fill it) -->
                <Border x:Name="XfaBar" Visibility="Collapsed" Padding="14,8" Margin="12,10,12,0" CornerRadius="6"
                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <DockPanel>
                        <Button x:Name="XfaBarClose" DockPanel.Dock="Right" Style="{StaticResource IconButton}" FontSize="10" Height="26" MinWidth="26"
                                Content="&#xE711;" ToolTip="Dismiss" AutomationProperties.Name="Dismiss" />
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="16" Margin="0,0,12,0"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="This form uses XFA, which PdfDesk can't fill. What you see may be only a placeholder page; open it in Adobe Acrobat Reader to fill it in." />
                    </DockPanel>
                </Border>

                <!-- InfoBar: digital signatures -->
                <Border x:Name="SigBar" Visibility="Collapsed" Padding="14,8" Margin="12,10,12,0" CornerRadius="6"
                        Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <DockPanel>
                        <Button x:Name="SigBarClose" DockPanel.Dock="Right" Style="{StaticResource IconButton}" FontSize="10" Height="26" MinWidth="26"
                                Content="&#xE711;" ToolTip="Dismiss" AutomationProperties.Name="Dismiss" />
                        <Button x:Name="SigBarDetails" DockPanel.Dock="Right" Content="Signature details" Margin="12,0,4,0" />
                        <TextBlock x:Name="SigBarIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xEB95;" FontSize="16" Margin="0,0,12,0" />
                        <TextBlock x:Name="SigBarText" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <!-- InfoBar: redaction marks waiting to be applied -->
                <Border x:Name="RedactBar" Visibility="Collapsed" Padding="14,8" Margin="12,10,12,0" CornerRadius="6"
                        Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <DockPanel>
                        <Button x:Name="RedactDone" DockPanel.Dock="Right" Style="{StaticResource IconButton}" FontSize="10" Height="26" MinWidth="26"
                                Content="&#xE711;" ToolTip="Leave the redaction tool (marks stay until you clear them)" AutomationProperties.Name="Close redaction bar" />
                        <Button x:Name="RedactApply" DockPanel.Dock="Right" Content="Apply redactions…" Margin="8,0,4,0" Style="{DynamicResource AccentButtonStyle}" />
                        <Button x:Name="RedactClear" DockPanel.Dock="Right" Content="Clear marks" Margin="12,0,0,0" />
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="16" Margin="0,0,12,0"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                        <TextBlock x:Name="RedactBarText" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>
                </StackPanel>

                <v:PageViewer x:Name="Viewer" Grid.Row="1" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                              AutomationProperties.Name="Document pages">
                    <v:PageViewer.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="CtxHighlight" Command="app:Cmd.Highlight" />
                            <MenuItem x:Name="CtxUnderline" Command="app:Cmd.Underline" />
                            <MenuItem x:Name="CtxStrikeOut" Command="app:Cmd.StrikeOut" />
                            <MenuItem x:Name="CtxRedactText" Header="Mark Text for _Redaction" />
                            <Separator x:Name="CtxMarkupSeparator" />
                            <MenuItem Command="app:Cmd.Copy" />
                            <MenuItem Command="app:Cmd.SelectAll" />
                            <Separator />
                            <MenuItem Command="app:Cmd.ToolHand" InputGestureText="H" />
                            <MenuItem Command="app:Cmd.ToolSelect" InputGestureText="T" />
                            <MenuItem Command="app:Cmd.ToolSnapshot" InputGestureText="G" />
                            <Separator />
                            <MenuItem Command="app:Cmd.Back" />
                            <MenuItem Command="app:Cmd.Forward" />
                            <Separator />
                            <MenuItem Command="app:Cmd.ZoomIn" />
                            <MenuItem Command="app:Cmd.ZoomOut" />
                            <MenuItem Command="app:Cmd.FitWidth" />
                            <MenuItem Command="app:Cmd.FitPage" />
                            <Separator />
                            <MenuItem Command="app:Cmd.RotateRight" Header="Rotate Page Clockwise" />
                            <MenuItem Command="app:Cmd.RotateLeft" Header="Rotate Page Counterclockwise" />
                            <MenuItem Command="app:Cmd.Organize" />
                            <MenuItem Command="app:Cmd.Print" />
                        </ContextMenu>
                    </v:PageViewer.ContextMenu>
                </v:PageViewer>

                <!-- Find widget (Ctrl+F), floating top-right -->
                <Border x:Name="FindBar" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,28,0" Padding="6"
                        Visibility="Collapsed" CornerRadius="8" Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.22" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="FindBox" Width="230" VerticalContentAlignment="Center" AutomationProperties.Name="Find in document"
                                 ToolTip="Enter: next match · Shift+Enter: previous · Esc: close" />
                        <TextBlock x:Name="FindStatus" Margin="10,0,6,0" VerticalAlignment="Center" MinWidth="64" FontSize="12" Style="{StaticResource Caption}" />
                        <ToggleButton x:Name="FindMatchCase" Style="{StaticResource CommandButton}" Content="Aa" FontWeight="SemiBold" ToolTip="Match case" Padding="8,4"
                                      AutomationProperties.Name="Match case" />
                        <ToggleButton x:Name="FindWholeWords" Style="{StaticResource CommandButton}" Content="ab|" FontWeight="SemiBold" ToolTip="Whole words" Padding="8,4"
                                      AutomationProperties.Name="Whole words" />
                        <ToggleButton x:Name="FindIgnoreAccents" Style="{StaticResource CommandButton}" Content="é=e" FontWeight="SemiBold" Padding="8,4"
                                      ToolTip="Ignore accents" AutomationProperties.Name="Ignore accents" />
                        <Button x:Name="FindPrevButton" Style="{StaticResource IconButton}" Content="&#xE70E;" FontSize="12" ToolTip="Previous match (Shift+F3)" />
                        <Button x:Name="FindNextButton" Style="{StaticResource IconButton}" Content="&#xE70D;" FontSize="12" ToolTip="Next match (F3)" />
                        <Button x:Name="FindCloseButton" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" ToolTip="Close (Esc)" />
                    </StackPanel>
                </Border>

                <!-- Page and zoom pill, floating bottom-center -->
                <Border x:Name="Pill" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" Padding="6,4"
                        CornerRadius="20" Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.22" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Command="app:Cmd.PrevPage" Content="&#xE76B;" FontSize="12" ToolTip="Previous page (Left / PgUp)" />
                        <TextBox x:Name="PageBox" MinWidth="48" MaxWidth="120" VerticalAlignment="Center" HorizontalContentAlignment="Center" Margin="2,0"
                                 AutomationProperties.Name="Page number" ToolTip="Type a page number (or the page's label, such as iv) and press Enter (Ctrl+G)" />
                        <TextBlock x:Name="PageCountText" VerticalAlignment="Center" Margin="6,0,4,0" MinWidth="32" Style="{StaticResource Caption}" />
                        <Button Style="{StaticResource IconButton}" Command="app:Cmd.NextPage" Content="&#xE76C;" FontSize="12" ToolTip="Next page (Right / PgDn)" />
                        <Border Style="{StaticResource BarSeparator}" />
                        <Button Style="{StaticResource IconButton}" Command="app:Cmd.ZoomOut" Content="&#xE738;" FontSize="12" ToolTip="Zoom out (Ctrl+-)" />
                        <ComboBox x:Name="ZoomBox" IsEditable="True" Width="96" VerticalAlignment="Center" Margin="2,0"
                                  AutomationProperties.Name="Zoom" ToolTip="Zoom (Ctrl+mouse wheel or pinch)" />
                        <Button Style="{StaticResource IconButton}" Command="app:Cmd.ZoomIn" Content="&#xE710;" FontSize="12" ToolTip="Zoom in (Ctrl+=)" />
                        <Border Style="{StaticResource BarSeparator}" />
                        <ToggleButton x:Name="FitWidthButton" Style="{StaticResource IconButton}" Command="app:Cmd.FitWidth" Content="&#xE9A6;" FontSize="14" ToolTip="Fit width (Ctrl+2)" />
                        <ToggleButton x:Name="FitPageButton" Style="{StaticResource IconButton}" Command="app:Cmd.FitPage" Content="&#xE7C3;" FontSize="14" ToolTip="Fit page (Ctrl+0)" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Organize pages (grid of large cards) -->
            <app:OrganizerView x:Name="Organizer" Visibility="Collapsed" />

            <!-- Busy veil for page edits (appears only if an edit takes noticeably long) -->
            <Border x:Name="BusyOverlay" Visibility="Collapsed" Background="#22000000">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Card}" Padding="20,14">
                    <StackPanel Orientation="Horizontal">
                        <ProgressBar IsIndeterminate="True" Width="80" Height="4" VerticalAlignment="Center" />
                        <TextBlock x:Name="BusyText" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>

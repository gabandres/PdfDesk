<UserControl x:Class="PdfDesk.App.DocumentTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:PdfDesk.App.Viewer"
             xmlns:app="clr-namespace:PdfDesk.App"
             xmlns:core="clr-namespace:PdfDesk.Core;assembly=PdfDesk.Core">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavColumn" Width="210" MinWidth="0" />
            <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation pane -->
        <TabControl x:Name="NavTabs" Grid.Column="0" Padding="0" BorderThickness="0">
            <TabItem x:Name="PagesTab" ToolTip="Page thumbnails">
                <TabItem.Header>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A9;" FontSize="15" />
                </TabItem.Header>
                <ListBox x:Name="Thumbs" SelectionMode="Extended" AllowDrop="True" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         HorizontalContentAlignment="Center">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type app:ThumbItem}">
                            <StackPanel Margin="2,6,2,2">
                                <Border Background="White" BorderBrush="#55000000" BorderThickness="1"
                                        Width="{Binding Width}" Height="{Binding Height}" HorizontalAlignment="Center">
                                    <Image Source="{Binding Image}" Stretch="Fill" />
                                </Border>
                                <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="12" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="app:Cmd.RotateRight" />
                            <MenuItem Command="app:Cmd.RotateLeft" />
                            <Separator />
                            <MenuItem Command="app:Cmd.DeleteSelected" InputGestureText="Del" />
                            <MenuItem Command="app:Cmd.DuplicatePages" />
                            <MenuItem Command="app:Cmd.ExtractPages" />
                            <MenuItem Command="app:Cmd.MovePages" />
                            <Separator />
                            <MenuItem Command="app:Cmd.InsertPages" />
                            <MenuItem Command="app:Cmd.InsertBlank" />
                            <MenuItem Command="app:Cmd.CropPages" />
                            <Separator />
                            <MenuItem Command="app:Cmd.Print" Header="_Print Pages…" />
                            <MenuItem Command="app:Cmd.ExportImages" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </TabItem>

            <TabItem x:Name="BookmarksTab" ToolTip="Bookmarks">
                <TabItem.Header>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A4;" FontSize="15" />
                </TabItem.Header>
                <Grid>
                    <TreeView x:Name="Outline" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type core:OutlineNode}" ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <TextBlock x:Name="NoBookmarks" Text="This document has no bookmarks." Margin="12"
                               TextWrapping="Wrap" Style="{StaticResource Caption}" Visibility="Collapsed" />
                </Grid>
            </TabItem>

            <TabItem x:Name="SearchTab" ToolTip="Search">
                <TabItem.Header>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="15" />
                </TabItem.Header>
                <DockPanel Margin="8">
                    <TextBox x:Name="SearchBox" DockPanel.Dock="Top" ToolTip="Text to search for" />
                    <StackPanel DockPanel.Dock="Top" Margin="0,6,0,0">
                        <CheckBox x:Name="SearchMatchCase" Content="Match case" />
                        <CheckBox x:Name="SearchWholeWords" Content="Whole words" Margin="0,2,0,0" />
                        <Button x:Name="SearchButton" Content="Search" Margin="0,6,0,0" HorizontalAlignment="Left" MinWidth="90" />
                    </StackPanel>
                    <TextBlock x:Name="SearchStatus" DockPanel.Dock="Top" Margin="0,8,0,4" TextWrapping="Wrap" Style="{StaticResource Caption}" />
                    <ListBox x:Name="SearchResults" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type v:SearchHit}">
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding PageLabel}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{Binding Excerpt}" TextWrapping="Wrap" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
        </TabControl>

        <GridSplitter x:Name="NavSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                      Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

        <DockPanel Grid.Column="2">
            <!-- Find bar (Ctrl+F) -->
            <Border x:Name="FindBar" DockPanel.Dock="Top" Visibility="Collapsed" Padding="8,6"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="FindBox" Width="260" VerticalContentAlignment="Center" ToolTip="Find (Enter: next, Shift+Enter: previous)" />
                    <Button x:Name="FindPrevButton" Margin="6,0,0,0" ToolTip="Previous (Shift+F3)" Padding="10,6">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70E;" />
                    </Button>
                    <Button x:Name="FindNextButton" Margin="4,0,0,0" ToolTip="Next (F3)" Padding="10,6">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" />
                    </Button>
                    <CheckBox x:Name="FindMatchCase" Content="Match case" Margin="12,0,0,0" VerticalAlignment="Center" />
                    <CheckBox x:Name="FindWholeWords" Content="Whole words" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="FindStatus" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}" />
                    <Button x:Name="FindCloseButton" Margin="12,0,0,0" ToolTip="Close (Esc)" Padding="10,6">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" />
                    </Button>
                </StackPanel>
            </Border>

            <v:PageViewer x:Name="Viewer">
                <v:PageViewer.ContextMenu>
                    <ContextMenu>
                        <MenuItem Command="app:Cmd.Copy" />
                        <MenuItem Command="app:Cmd.SelectAll" />
                        <Separator />
                        <MenuItem Command="app:Cmd.ToolHand" InputGestureText="H" />
                        <MenuItem Command="app:Cmd.ToolSelect" InputGestureText="T" />
                        <MenuItem Command="app:Cmd.ToolSnapshot" InputGestureText="G" />
                        <Separator />
                        <MenuItem Command="app:Cmd.Back" />
                        <MenuItem Command="app:Cmd.Forward" />
                        <Separator />
                        <MenuItem Command="app:Cmd.ZoomIn" />
                        <MenuItem Command="app:Cmd.ZoomOut" />
                        <MenuItem Command="app:Cmd.FitWidth" />
                        <MenuItem Command="app:Cmd.FitPage" />
                        <Separator />
                        <MenuItem Command="app:Cmd.RotateRight" />
                        <MenuItem Command="app:Cmd.RotateLeft" />
                        <MenuItem Command="app:Cmd.Print" />
                    </ContextMenu>
                </v:PageViewer.ContextMenu>
            </v:PageViewer>
        </DockPanel>

        <!-- Busy overlay for page edits -->
        <Border x:Name="BusyOverlay" Grid.ColumnSpan="3" Visibility="Collapsed" Background="#33000000">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Card}">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar IsIndeterminate="True" Width="80" Height="4" VerticalAlignment="Center" />
                    <TextBlock x:Name="BusyText" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>

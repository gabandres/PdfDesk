<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Architecture-neutral IL, so the x64 and ARM64 app builds (Directory.Build.props defaults to win-arm64) can both reference it -->
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <!-- HarfBuzzSharp (MIT): complex-script shaping and font subsetting for Fill & Sign, form appearances and OCR text. Ships win-arm64 natives. -->
    <PackageReference Include="HarfBuzzSharp" Version="14.2.1.301" />
    <!-- Jint (BSD-2-Clause; pulls Acornima, BSD-3-Clause): sandboxed JavaScript for AcroForm scripts. Pure .NET, no CLR access enabled. -->
    <PackageReference Include="Jint" Version="4.17.0" />
    <!-- MuPDF (AGPL; personal use): rendering, text, search, outline, links. Ships win-arm64 natives. -->
    <PackageReference Include="MuPDFCore" Version="2.0.1" />
    <!-- PDFsharp 6.2.x (MIT; 6.5+ is AGPL with a runtime license check): page-level editing (merge, split, insert, delete, reorder, rotate, crop) -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <!-- PDFsharp pulls Pkcs 8.0.1 (GHSA-846f-f764-76mx); pin the patched release -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="InkvoltPdf.Tests" />
  </ItemGroup>
</Project>

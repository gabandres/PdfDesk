<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WinTfm>net10.0-windows10.0.22621.0</WinTfm>
    <!-- Release: PDB embedded in the dll/exe, so crash logs get file and line numbers (works with single-file publish) -->
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- Native ARM64 build (MuPDF ships a win-arm64 native library) -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-arm64</RuntimeIdentifier>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
  </PropertyGroup>
  <!-- Desk suite: PdfDesk.App uses PrintDesk's libraries (scanning, printer status) from its own repo. PrintDeskRoot is the
       PrintDesk checkout: the PrintDeskRoot environment variable if set, else a PrintDesk\ folder beside any folder above
       this one (Z:\PrintDesk from Z:\PdfDesk and from its worktrees), else Z:\PrintDesk\. PrintDesk's projects build with
       PrintDesk's own Directory.Build.props (MSBuild picks the nearest one above each project). -->
  <PropertyGroup>
    <_DeskSiblingRoot Condition="'$(PrintDeskRoot)' == ''">$([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildThisFileDirectory)', 'PrintDesk\PrintDesk.slnx'))</_DeskSiblingRoot>
    <PrintDeskRoot Condition="'$(PrintDeskRoot)' == '' and '$(_DeskSiblingRoot)' != ''">$([System.IO.Path]::Combine('$(_DeskSiblingRoot)', 'PrintDesk'))</PrintDeskRoot>
    <PrintDeskRoot Condition="'$(PrintDeskRoot)' == ''">Z:\PrintDesk\</PrintDeskRoot>
    <PrintDeskRoot>$([MSBuild]::EnsureTrailingSlash('$(PrintDeskRoot)'))</PrintDeskRoot>
  </PropertyGroup>
</Project>
